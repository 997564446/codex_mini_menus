.order-page{min-height:100vh;padding:28rpx 28rpx calc(150rpx + env(safe-area-inset-bottom))}.meal-banner{display:flex;align-items:center;justify-content:space-between;padding:28rpx;background:linear-gradient(135deg,#fff0ce,#fff)}.meal-title{display:block;font-size:35rpx;font-weight:800}.meal-copy{display:block;margin-top:8rpx;color:#8a7d70;font-size:22rpx}.meal-emoji{font-size:70rpx}.locked-tip{margin:20rpx 0;padding:18rpx 22rpx;border-radius:18rpx;background:#fff0ee;color:#b65547;font-size:23rpx}.dish-card{margin-top:20rpx;padding:22rpx}.dish-main{display:flex;align-items:center;gap:16rpx}.dish-image{display:flex;width:120rpx;height:120rpx;flex:none;align-items:center;justify-content:center;border-radius:20rpx;background:#fff2dc;font-size:47rpx}.dish-info{min-width:0;flex:1}.dish-name{display:block;font-size:29rpx;font-weight:800}.dish-copy{display:block;margin:7rpx 0;overflow:hidden;color:#8a7d70;font-size:20rpx;text-overflow:ellipsis;white-space:nowrap}.stepper{display:flex;align-items:center;gap:10rpx}.stepper button{display:flex;width:54rpx;height:54rpx;margin:0;padding:0;align-items:center;justify-content:center;border:0;border-radius:50%;background:#fff0e9;color:#ef6a4c;font-size:26rpx;line-height:54rpx}.stepper button::after{border:0}.stepper text{min-width:30rpx;text-align:center;font-weight:700}.spec-area{margin-top:20rpx;padding-top:18rpx;border-top:2rpx dashed #eee4d9}.spec-block{margin-bottom:18rpx}.spec-title{display:block;margin-bottom:12rpx;font-size:24rpx;font-weight:700}.required,.optional{margin-left:8rpx;color:#ef6a4c;font-size:19rpx;font-weight:400}.optional{color:#999}.option-row{display:flex;flex-wrap:wrap;gap:10rpx}.option-pill{padding:9rpx 14rpx;border:2rpx solid #eee4d9;border-radius:999rpx;color:#6c6056;font-size:21rpx}.option-pill.selected{border-color:#f0a084;background:#fff0e9;color:#d75d42}.option-pill radio,.option-pill checkbox{display:none}.item-note{height:68rpx;margin-top:16rpx;padding:0 18rpx;border-radius:14rpx;background:#f8f3ed;font-size:22rpx}.note-card{margin-top:22rpx;padding:24rpx}.submit-bar{position:fixed;z-index:20;right:22rpx;bottom:calc(18rpx + env(safe-area-inset-bottom));left:22rpx;display:flex;height:110rpx;align-items:center;justify-content:space-between;padding:14rpx 16rpx 14rpx 28rpx;border-radius:30rpx;background:#332c27;color:#fff;box-shadow:0 15rpx 40rpx rgba(48,39,32,.25)}.submit-count{display:block;font-size:21rpx;opacity:.75}.submit-total{display:block;margin-top:5rpx;font-size:30rpx;font-weight:800}.submit-btn{height:78rpx;margin:0;padding:0 30rpx;border:0;border-radius:22rpx;background:#ef6a4c;color:#fff;font-size:27rpx;font-weight:700;line-height:78rpx}.submit-btn::after{border:0}
.order-menu-layout{display:flex;height:780rpx;margin-top:22rpx;overflow:hidden}.order-category-sidebar{width:180rpx;height:100%;flex:none;border-right:2rpx solid #eee6dd;background:#faf6f0}.order-category{display:flex;min-height:96rpx;flex-direction:column;align-items:center;justify-content:center;padding:12rpx;border-left:6rpx solid transparent;color:#74685e;font-size:24rpx;text-align:center}.order-category.active{border-left-color:#ef6a4c;background:#fff;color:#d75d42;font-weight:800}.required-dot{margin-top:5rpx;color:#ef6a4c;font-size:18rpx}.order-dish-panel{display:flex;min-width:0;height:100%;flex:1;flex-direction:column}.order-dish-head{display:flex;min-height:82rpx;flex:none;align-items:center;justify-content:space-between;padding:14rpx 18rpx;border-bottom:2rpx solid #eee6dd;font-size:26rpx;font-weight:800}.order-dish-head .muted{font-size:17rpx;font-weight:400}.order-dish-list{min-height:0;flex:1}.dish-card{margin:0;padding:22rpx 18rpx;border-bottom:2rpx solid #f1ebe5}.dish-card.sold-out{background:#f3f3f3;color:#aaa}.dish-card.sold-out .dish-copy{color:#aaa}.dish-main{gap:10rpx}.dish-name{font-size:25rpx}.stepper{gap:6rpx}.stepper button{width:48rpx;height:48rpx;font-size:23rpx;line-height:48rpx}.stepper button[disabled]{background:#e8e8e8;color:#aaa}.spec-title{font-size:22rpx}.option-pill{font-size:19rpx}.item-note{font-size:20rpx}
