<view class="order-page">
  <view wx:if="{{loading}}" class="card empty-state"><text class="empty-emoji">🥄</text><text class="empty-copy">正在准备菜单…</text></view>
  <block wx:else>
    <view class="meal-banner card"><view><text class="meal-title">{{meal.date}} · {{meal.mealLabel}}</text><text class="meal-copy">参考价格仅用于家庭记账，无需付款</text></view><text class="meal-emoji">{{meal.mealType === 'breakfast' ? '🥛' : meal.mealType === 'lunch' ? '🍱' : '🍲'}}</text></view>
    <view wx:if="{{existingOrder && existingOrder.status !== 'pending'}}" class="locked-tip">🔒 厨师已处理或订单已取消，现在不能修改。</view>

    <view wx:for="{{dishes}}" wx:key="_id" class="dish-card card">
      <view class="dish-main">
        <image wx:if="{{item.imageFileId}}" class="dish-image" src="{{item.imageFileId}}" mode="aspectFill" />
        <view wx:else class="dish-image placeholder">🥘</view>
        <view class="dish-info"><text class="dish-name">{{item.name}}</text><text class="dish-copy">{{item.description || '今天也是家里的好味道'}}</text><text class="price">¥{{item.priceText}} / 份</text></view>
        <view class="stepper"><button disabled="{{item.quantity === 0}}" data-index="{{index}}" data-delta="-1" bindtap="changeQuantity">−</button><text>{{item.quantity}}</text><button data-index="{{index}}" data-delta="1" bindtap="changeQuantity">＋</button></view>
      </view>
      <view wx:if="{{item.quantity > 0 && item.specs.length}}" class="spec-area">
        <view wx:for="{{item.specs}}" wx:for-item="spec" wx:for-index="specIndex" wx:key="name" class="spec-block">
          <text class="spec-title">{{spec.name}} <text wx:if="{{spec.required}}" class="required">必选</text><text wx:else class="optional">选填</text></text>
          <radio-group wx:if="{{spec.type === 'single'}}" class="option-row" data-dish="{{index}}" data-spec="{{specIndex}}" bindchange="onSingleSpec">
            <label wx:for="{{spec.options}}" wx:for-item="option" wx:key="value" class="option-pill {{option.checked ? 'selected' : ''}}"><radio value="{{option.value}}" checked="{{option.checked}}" color="#ef6a4c" />{{option.value}}</label>
          </radio-group>
          <checkbox-group wx:else class="option-row" data-dish="{{index}}" data-spec="{{specIndex}}" bindchange="onMultipleSpec">
            <label wx:for="{{spec.options}}" wx:for-item="option" wx:key="value" class="option-pill {{option.checked ? 'selected' : ''}}"><checkbox value="{{option.value}}" checked="{{option.checked}}" color="#55a66f" />{{option.value}}</label>
          </checkbox-group>
        </view>
      </view>
      <input wx:if="{{item.quantity > 0}}" class="item-note" value="{{item.itemNote}}" data-index="{{index}}" bindinput="onItemNote" maxlength="80" placeholder="这道菜的备注，例如：少盐、不要葱" />
    </view>

    <view class="note-card card"><text class="field-label">整单备注</text><textarea class="textarea" value="{{note}}" bindinput="onNote" maxlength="200" placeholder="告诉厨师这顿饭的其他需要" /></view>
    <view class="submit-bar">
      <view><text class="submit-count">已选 {{selectedCount}} 道</text><text class="submit-total">参考 ¥{{totalText}}</text></view>
      <button class="submit-btn" loading="{{saving}}" disabled="{{saving || (existingOrder && existingOrder.status !== 'pending')}}" bindtap="submit">{{existingOrder ? '保存修改' : '告诉厨师'}}</button>
    </view>
  </block>
</view>
