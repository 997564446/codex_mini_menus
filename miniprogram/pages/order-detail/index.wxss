.detail-page{min-height:100vh;padding:28rpx 28rpx calc(45rpx + env(safe-area-inset-bottom))}.status-card{display:flex;align-items:center;gap:24rpx;padding:34rpx;background:linear-gradient(135deg,#fff0ce,#fff)}.status-ready{background:linear-gradient(135deg,#dff4e6,#fff)}.status-cancelled{background:linear-gradient(135deg,#eee,#fff)}.status-emoji{font-size:76rpx}.status-title{display:block;font-size:38rpx;font-weight:800}.status-copy{display:block;margin-top:9rpx;color:#8a7d70;font-size:24rpx}.items-card{padding:10rpx 24rpx}.item-row{display:flex;align-items:center;gap:16rpx;padding:22rpx 0;border-bottom:2rpx solid #f1e9e1}.item-image{display:flex;width:90rpx;height:90rpx;flex:none;align-items:center;justify-content:center;border-radius:17rpx;background:#fff1d7;font-size:38rpx}.item-body{min-width:0;flex:1}.item-name{display:block;font-size:27rpx;font-weight:800}.item-spec,.item-note{display:block;margin-top:7rpx;color:#8a7d70;font-size:21rpx;line-height:1.4}.item-note{color:#b46e56}.item-price{font-size:25rpx;font-weight:700}.total-row{display:flex;align-items:center;justify-content:space-between;padding:27rpx 0;font-size:24rpx}.total-price{color:#ef6a4c;font-size:34rpx;font-weight:800}.remark,.cancel-reason{padding:26rpx;color:#675a50;font-size:25rpx;line-height:1.6}.cancel-reason{margin-top:20rpx;background:#fff0ee;color:#a65347}.action-row{display:flex;gap:18rpx;margin-top:34rpx}.action-row button{flex:1}
