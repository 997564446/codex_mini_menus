<view class="page">
  <view class="hero card {{role === 'chef' ? 'chef-hero' : ''}}">
    <view>
      <text class="eyebrow">{{role === 'chef' ? '今日厨房' : session.family.name}}</text>
      <text class="hero-title">{{role === 'chef' ? '大厨，今天辛苦啦' : '今天想吃点什么？'}}</text>
      <text class="hero-copy">{{role === 'chef' ? '订单按餐次汇总，备菜一眼就看清' : '选好日期和餐次，再慢慢挑喜欢的菜'}}</text>
    </view>
    <text class="hero-emoji">{{role === 'chef' ? '👩‍🍳' : '🍲'}}</text>
  </view>

  <scroll-view class="date-strip" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="date-row">
      <view
        wx:for="{{dates}}"
        wx:key="value"
        class="date-chip {{selectedDate === item.value ? 'selected' : ''}}"
        data-date="{{item.value}}"
        bindtap="selectDate"
      >
        <text class="date-day">{{item.day}}</text>
        <text class="date-short">{{item.short}}</text>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="card empty-state">
    <text class="empty-emoji">🥄</text>
    <text class="empty-copy">正在翻开今天的菜单…</text>
  </view>

  <view wx:elif="{{!meals.length}}" class="card empty-state">
    <text class="empty-emoji">{{role === 'chef' ? '🗓️' : '🍽️'}}</text>
    <text class="empty-title">{{role === 'chef' ? '这天还没有安排餐次' : '大厨还没开放菜单'}}</text>
    <text class="empty-copy">{{role === 'chef' ? '到“菜单”里从菜品库安排一顿饭吧。' : '晚点再来看看，也可以提醒一下家里的厨师。'}}</text>
  </view>

  <block wx:else>
  <block wx:for="{{meals}}" wx:key="_id">
    <view wx:if="{{role === 'diner'}}" class="meal-card card" data-id="{{item._id}}" bindtap="openMeal">
      <view class="meal-head">
        <view>
          <text class="meal-title">{{item.mealLabel}}</text>
          <text class="meal-date">{{item.date}}</text>
        </view>
        <text class="pill">可以点餐</text>
      </view>
      <scroll-view class="dish-preview" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="dish-preview-row">
          <view wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="_id" class="preview-item">
            <image wx:if="{{dish.imageFileId}}" class="preview-image" src="{{dish.imageFileId}}" mode="aspectFill" />
            <view wx:else class="preview-image placeholder">🥘</view>
            <text class="preview-name">{{dish.name}}</text>
            <text class="preview-price">¥{{dish.priceText}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="meal-footer">
        <text class="muted">共 {{item.dishes.length}} 道菜</text>
        <text class="go-order">去点餐 →</text>
      </view>
    </view>

    <view wx:else class="kitchen-card card">
      <view class="meal-head">
        <view>
          <text class="meal-title">{{item.mealLabel}}</text>
          <text class="meal-date">{{item.date}} · {{item.status === 'open' ? '点餐中' : item.status === 'closed' ? '已关单' : '草稿'}}</text>
        </view>
        <view class="count-bubble"><text>{{item.dinerCount}}</text><text class="count-unit">人</text></view>
      </view>
      <view class="stats-row">
        <view class="stat"><text class="stat-number">{{item.totalQuantity}}</text><text class="stat-label">总份数</text></view>
        <view class="stat"><text class="stat-number orange">{{item.pendingCount}}</text><text class="stat-label">待确认</text></view>
        <view class="stat"><text class="stat-number">{{item.dishSummary.length}}</text><text class="stat-label">菜品组合</text></view>
      </view>
      <view wx:if="{{item.dishSummary.length}}" class="summary-box">
        <view wx:for="{{item.dishSummary}}" wx:for-item="summary" wx:key="name" class="summary-line">
          <text>{{summary.name}}<text wx:if="{{summary.specs}}" class="summary-spec">（{{summary.specs}}）</text></text>
          <text class="summary-qty">× {{summary.quantity}}</text>
        </view>
      </view>
      <view wx:if="{{item.notes.length}}" class="note-box">
        <text class="note-title">📝 食客备注</text>
        <text wx:for="{{item.notes}}" wx:for-item="note" wx:key="dinerName" class="note-line">{{note.dinerName}}：{{note.note}}</text>
      </view>
      <view wx:if="{{item.orders.length}}" class="order-list">
        <view wx:for="{{item.orders}}" wx:for-item="order" wx:key="_id" class="order-row" data-id="{{order._id}}" bindtap="openOrder">
          <view><text class="order-name">{{order.dinerName}}</text><text class="order-status status-{{order.status}}">{{order.statusLabel}}</text></view>
          <text class="muted">{{order.items.length}} 道 · ¥{{order.totalText}} ›</text>
        </view>
      </view>
      <view class="batch-actions">
        <button size="mini" class="mini-action confirm" data-id="{{item._id}}" data-status="confirmed" bindtap="batchStatus">确认待处理</button>
        <button size="mini" class="mini-action" data-id="{{item._id}}" data-status="cooking" bindtap="batchStatus">开始制作</button>
        <button size="mini" class="mini-action green" data-id="{{item._id}}" data-status="ready" bindtap="batchStatus">通知取餐</button>
        <button size="mini" class="mini-action plain" data-id="{{item._id}}" data-status="completed" bindtap="batchStatus">完成</button>
      </view>
    </view>
  </block>
  </block>
</view>
