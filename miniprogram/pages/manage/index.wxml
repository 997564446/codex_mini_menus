<view class="page">
  <view wx:if="{{role === 'chef'}}">
    <view class="top-title">
      <view><text class="page-title">家里的菜单</text><text class="page-copy">整理菜品库存，再安排每周菜单</text></view>
      <text class="top-emoji">📖</text>
    </view>
    <view class="segment card">
      <view class="segment-item {{chefTab === 'dishes' ? 'active' : ''}}" data-tab="dishes" bindtap="switchChefTab">菜品库</view>
      <view class="segment-item {{chefTab === 'meals' ? 'active' : ''}}" data-tab="meals" bindtap="switchChefTab">星期菜单</view>
    </view>

    <view wx:if="{{chefTab === 'dishes'}}">
      <view class="toolbar">
        <button class="toolbar-btn ghost" bindtap="addCategory">＋ 分类</button>
        <text class="toolbar-tip">左选分类，右勾菜品</text>
      </view>
      <view wx:if="{{loading}}" class="card empty-state"><text class="empty-copy">正在整理菜品库…</text></view>
      <view wx:elif="{{!dishes.length}}" class="card empty-state">
        <text class="empty-emoji">🥬</text><text class="empty-title">正在初始化菜品库</text><text class="empty-copy">稍后下拉刷新即可看到默认菜品。</text>
      </view>
      <view wx:else class="catalog-layout card">
        <scroll-view class="category-sidebar" scroll-y enhanced show-scrollbar="{{false}}">
          <view wx:for="{{categories}}" wx:key="_id" class="category-nav {{selectedCategoryId === item._id ? 'active' : ''}}" data-id="{{item._id}}" bindtap="selectCategory">
            <view class="category-nav-main"><text class="category-nav-name">{{item.name}}</text><text class="category-count">{{item.dishCount}}</text></view>
            <text wx:if="{{!item.isDefault}}" class="category-actions" data-id="{{item._id}}" catchtap="manageCategory">···</text>
          </view>
        </scroll-view>

        <view class="category-content">
          <view class="category-content-head">
            <view><text class="category-title">{{selectedCategoryName}}</text><text class="category-copy">{{selectedCategoryIsDefault ? '尚未归类的菜品' : '仅显示本分类和未分类，本分类排在前面'}}</text></view>
            <button wx:if="{{!selectedCategoryIsDefault}}" class="category-save" loading="{{categorySaving}}" disabled="{{categorySaving || !categoryDirty}}" bindtap="saveCategoryDishes">保存</button>
          </view>
          <scroll-view class="category-dish-list" scroll-y enhanced show-scrollbar="{{false}}">
            <view wx:if="{{!categoryDishes.length}}" class="category-empty">这个分类还没有菜品</view>
            <block wx:elif="{{selectedCategoryIsDefault}}">
              <view wx:for="{{categoryDishes}}" wx:key="_id" class="category-dish-row">
                <view class="category-dish-body"><text class="category-dish-name">{{item.name}}</text><text class="category-dish-meta">库存 {{item.stockText}}</text></view>
                <text class="stock-link" data-id="{{item._id}}" bindtap="editDish">库存 ›</text>
              </view>
            </block>
            <checkbox-group wx:else bindchange="onCategoryDishes">
              <view wx:for="{{categoryDishes}}" wx:key="_id" class="category-dish-row {{item.checked ? 'checked' : ''}}">
                <checkbox value="{{item._id}}" checked="{{item.checked}}" color="#55a66f" />
                <view class="category-dish-body"><text class="category-dish-name">{{item.name}}</text><text class="category-dish-meta">{{item.categoryDisplay}} · 库存 {{item.stockText}}</text></view>
                <text class="stock-link" data-id="{{item._id}}" catchtap="editDish">库存 ›</text>
              </view>
            </checkbox-group>
          </scroll-view>
        </view>
      </view>
    </view>

    <view wx:else>
      <view wx:if="{{loading}}" class="card empty-state"><text class="empty-copy">正在查看每周菜单…</text></view>
      <view wx:elif="{{!meals.length}}" class="card empty-state">
        <text class="empty-emoji">🗓️</text><text class="empty-title">星期菜单还没准备好</text><text class="empty-copy">下拉刷新后再试一次。</text>
      </view>
      <block wx:else>
        <view wx:for="{{meals}}" wx:key="_id" class="meal-row card" data-id="{{item._id}}" bindtap="editMeal">
          <view class="meal-icon">{{item.weekday}}</view>
          <view class="meal-body">
            <text class="meal-title">{{item.weekdayLabel}}菜单</text>
            <text class="meal-meta">已安排 {{item.dishIds.length}} 道菜</text>
          </view>
          <text class="muted">编辑 ›</text>
        </view>
      </block>
    </view>
  </view>

  <view wx:else>
    <view class="top-title"><view><text class="page-title">我的订单</text><text class="page-copy">每顿饭的进度，都在这里</text></view><text class="top-emoji">🧾</text></view>
    <view wx:if="{{loading}}" class="card empty-state"><text class="empty-copy">正在找你的订单…</text></view>
    <view wx:elif="{{!orders.length}}" class="card empty-state">
      <text class="empty-emoji">🍚</text><text class="empty-title">还没有点过餐</text><text class="empty-copy">到“点餐”看看大厨今天准备了什么。</text>
    </view>
    <block wx:else>
    <view wx:for="{{orders}}" wx:key="_id" class="order-card card" data-id="{{item._id}}" bindtap="openOrder">
      <view class="order-head"><text class="order-meal">{{item.mealDate}} · {{item.weekdayLabel}}</text><text class="order-state state-{{item.status}}">{{item.statusLabel}}</text></view>
      <text class="order-dishes">{{item.items[0].name}}{{item.items.length > 1 ? ' 等 ' + item.items.length + ' 道菜' : ''}}</text>
      <view class="order-foot"><text class="muted">查看点餐内容和处理进度</text><text class="price">详情 ›</text></view>
    </view>
    </block>
  </view>
</view>
