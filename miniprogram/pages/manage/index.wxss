.top-title{display:flex;align-items:center;justify-content:space-between;padding:20rpx 6rpx 28rpx}.page-title{display:block;font-size:44rpx;font-weight:800}.page-copy{display:block;margin-top:8rpx;color:#8a7d70;font-size:25rpx}.top-emoji{font-size:72rpx}.segment{display:flex;padding:8rpx;margin-bottom:24rpx}.segment-item{flex:1;padding:20rpx;border-radius:20rpx;color:#8a7d70;text-align:center;font-size:27rpx;font-weight:700}.segment-item.active{background:#332c27;color:#fff}.toolbar{display:flex;justify-content:space-between;gap:16rpx;margin:20rpx 0}.toolbar.right{justify-content:flex-end}.toolbar-btn{height:72rpx;margin:0;padding:0 28rpx;border:0;border-radius:18rpx;font-size:25rpx;line-height:72rpx}.toolbar-btn::after{border:0}.toolbar-btn.primary{background:#ef6a4c;color:#fff}.toolbar-btn.ghost{background:#fff0e9;color:#d95e43}.category-strip{width:calc(100% + 28rpx);margin:0 -14rpx 22rpx;white-space:nowrap}.category-row{display:inline-flex;gap:12rpx;padding:0 14rpx}.category-pill{display:flex;align-items:center;gap:10rpx;padding:13rpx 18rpx 13rpx 22rpx;border-radius:999rpx;background:#fff;color:#796b60;font-size:23rpx}.category-pill.default{padding-right:22rpx}.category-more{color:#b7aa9e;font-size:22rpx;letter-spacing:-2rpx}.dish-row{display:flex;align-items:center;gap:20rpx;margin-bottom:18rpx;padding:20rpx}.dish-image{display:flex;width:120rpx;height:120rpx;flex:none;align-items:center;justify-content:center;border-radius:20rpx;background:#fff2dd;font-size:46rpx}.dish-body{min-width:0;flex:1}.dish-name{font-size:29rpx;font-weight:800}.dish-meta{display:block;margin:9rpx 0;color:#8a7d70;font-size:22rpx}.state{margin-left:10rpx;padding:4rpx 9rpx;border-radius:8rpx;background:#eee;color:#888;font-size:18rpx}.state.on{background:#eaf7ee;color:#3c8e5a}.meal-row{display:flex;align-items:center;gap:18rpx;margin-bottom:18rpx;padding:24rpx}.meal-icon{display:flex;width:88rpx;height:88rpx;align-items:center;justify-content:center;border-radius:22rpx;background:#fff4cf;