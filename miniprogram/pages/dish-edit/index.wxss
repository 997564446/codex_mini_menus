.edit-page{min-height:100vh;padding:28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom))}.meal-hero{display:flex;align-items:center;gap:22rpx;padding:30rpx;background:linear-gradient(135deg,#fff0cf,#fff)}.meal-hero-emoji{font-size:66rpx}.meal-hero-title{display:block;font-size:34rpx;font-weight:800}.meal-hero-copy{display:block;margin-top:8rpx;color:#8a7d70;font-size:23rpx}.form-card{margin-top:24rpx;padding:28rpx}.picker-field{display:flex;align-items:center;justify-content:space-between}.stock-modes{display:flex;gap:16rpx}.stock-mode{display:flex;min-height:86rpx;flex:1;align-items:center;justify-content:center;border:2rpx solid #eee4d9;border-radius:20rpx;color:#75695f;font-size:25rpx}.stock-mode.selected{border-color:#55a66f;background:#eaf7ee;color:#3c8e5a;font-weight:700}.stock-mode radio{transform:scale(.82)}.unlimited-tip{margin-bottom:24rpx;padding:22rpx;border-radius:18rpx;background:#eaf7ee;color:#3c8e5a;font-size:23rpx;line-height:1.6}.stock-tip{margin-top:22rpx;padding:24rpx;color:#796b60;font-size:23rpx;line-height:1.7}.save-btn{margin-top:34rpx}
