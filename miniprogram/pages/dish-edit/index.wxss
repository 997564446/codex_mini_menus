.edit-page{min-height:100vh;padding:28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom))}.photo-card{position:relative;height:360rpx;overflow:hidden}.photo{width:100%;height:100%}.photo-empty{display:flex;height:100%;flex-direction:column;align-items:center;justify-content:center;background:#fff0d9;color:#8a725c;font-size:26rpx}.photo-emoji{margin-bottom:12rpx;font-size:74rpx}.photo-action{position:absolute;right:20rpx;bottom:20rpx;padding:11rpx 18rpx;border-radius:999rpx;background:rgba(42,36,31,.72);color:#fff;font-size:21rpx}.form-card{margin-top:24rpx;padding:28rpx}.picker-field{display:flex;align-items:center;justify-content:space-between}.add-link{color:#ef6a4c;font-size:25rpx}.spec-empty{padding:28rpx;color:#8a7d70;text-align:center;font-size:24rpx}.spec-card{margin-bottom:20rpx;padding:26rpx}.spec-head{display:flex;justify-content:space-between;margin-bottom:20rpx;font-size:27rpx;font-weight:800}.delete{color:#c65b4a;font-size:23rpx}.type-row{display:flex;align-items:center;gap:28rpx;padding:22rpx 4rpx;color:#65594f;font-size:24rpx}.required-label{display:flex;align-items:center;gap:8rpx;margin-left:auto}.required-label switch{transform:scale(.78)}.option-area{min-height:110rpx}.save-btn{margin-top:34rpx}
