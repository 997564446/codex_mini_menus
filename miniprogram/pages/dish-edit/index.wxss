.edit-page{min-height:100vh;padding:28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom))}.meal-hero{display:flex;align-items:center;gap:22rpx;padding:30rpx;background:linear-gradient(135deg,#fff0cf,#fff)}.meal-hero-emoji{font-size:66rpx}.meal-hero-title{display:block;font-size:34rpx;font-weight:800}.meal-hero-copy{display:block;margin-top:8rpx;color:#8a7d70;font-size:23rpx}.form-card{margin-top:24rpx;padding:28rpx}.picker-field{display:flex;align-items:center;justify-content:space-between}.stock-switch{display:flex;align-items:center;justify-content:space-between}.field-copy{display:block;margin-top:8rpx;color:#8a7d70;font-size:21rpx}.stock-tip{margin-top:22rpx;padding:24rpx;color:#796b60;font-size:23rpx;line-height:1.7}.save-btn{margin-top:34rpx}
