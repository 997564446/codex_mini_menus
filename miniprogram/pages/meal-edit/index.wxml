<view class="edit-page">
  <view class="meal-hero card"><text class="meal-hero-emoji">🗓️</text><view><text class="meal-hero-title">设置{{weekdayLabel}}菜单</text><text class="meal-hero-copy">勾选当天可供家人选择的菜品</text></view></view>

  <view class="section-title"><text>选择菜品</text><text class="selected-count">已选 {{selectedDishIds.length}}</text></view>
  <view wx:if="{{!dishes.length}}" class="card empty-state"><text class="empty-emoji">🥕</text><text class="empty-title">菜品库还没准备好</text><text class="empty-copy">请返回菜品库下拉刷新。</text></view>
  <checkbox-group wx:else bindchange="onDishes">
    <label wx:for="{{dishes}}" wx:key="_id" class="dish-choice card">
      <view class="dish-image placeholder">🥘</view>
      <view class="dish-body"><text class="dish-name">{{item.name}}</text><text class="dish-copy">{{item.categoryName}} · {{item.stockText}}</text></view>
      <checkbox value="{{item._id}}" checked="{{item.checked}}" color="#55a66f" />
    </label>
  </checkbox-group>
  <button class="primary-btn save-btn" loading="{{saving}}" disabled="{{saving || !dishes.length}}" bindtap="save">保存{{weekdayLabel}}菜单</button>
</view>
