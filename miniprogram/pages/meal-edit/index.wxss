.edit-page{min-height:100vh;padding:28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom))}.meal-hero{display:flex;align-items:center;gap:22rpx;padding:30rpx;background:linear-gradient(135deg,#fff0cf,#fff)}.meal-hero-emoji{font-size:66rpx}.meal-hero-title{display:block;font-size:34rpx;font-weight:800}.meal-hero-copy{display:block;margin-top:8rpx;color:#8a7d70;font-size:23rpx}.form-card{margin-top:22rpx;padding:28rpx}.picker-field{display:flex;align-items:center;justify-content:space-between}.meal-types{display:flex;gap:14rpx}.meal-type{display:flex;flex:1;height:112rpx;flex-direction:column;align-items:center;justify-content:center;border:2rpx solid #eee4d9;border-radius:20rpx;color:#75695f;font-size:23rpx}.meal-type.selected{border-color:#ef6a4c;background:#fff0e9;color:#d85d42;font-weight:700}.meal-type-emoji{margin-bottom:7rpx;font-size:39rpx}.selected-count{color:#55a66f;font-size:24rpx}.dish-choice{display:flex;align-items:center;gap:18rpx;margin-bottom:16rpx;padding:18rpx}.dish-image{display:flex;width:104rpx;height:104rpx;flex:none;align-items:center;justify-content:center;border-radius:18rpx;background:#fff2db;font-size:43rpx}.dish-body{min-width:0;flex:1}.dish-name{display:block;font-size:28rpx;font-weight:800}.dish-copy{display:block;margin-top:7rpx;overflow:hidden;color:#8a7d70;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.save-btn{margin-top:32rpx}
