.edit-page{min-height:100vh;padding:28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom))}.meal-hero{display:flex;align-items:center;gap:22rpx;padding:30rpx;background:linear-gradient(135deg,#fff0cf,#fff)}.meal-hero-emoji{font-size:66rpx}.meal-hero-title{display:block;font-size:34rpx;font-weight:800}.meal-hero-copy{display:block;margin-top:8rpx;color:#8a7d70;font-size:23rpx}.meal-picker{display:block;margin-top:18rpx;padding:20rpx 24rpx}.meal-picker-value{display:flex;align-items:center;justify-content:space-between;color:#75695f;font-size:24rpx}.meal-picker-label{color:#3d8253;font-size:27rpx;font-weight:800}.menu-layout{display:flex;height:calc(100vh - 500rpx);min-height:620rpx;margin-top:18rpx;overflow:hidden}.category-sidebar{box-sizing:border-box;width:190rpx;height:100%;flex:none;border-right:2rpx solid #f0e8df;background:#faf7f3}.category-nav{display:flex;min-height:92rpx;align-items:center;justify-content:space-between;padding:18rpx 16rpx;border-left:6rpx solid transparent;color:#75695f}.category-nav.active{border-left-color:#55a66f;background:#fff;color:#2f6f45;font-weight:800}.category-name{min-width:0;overflow:hidden;font-size:25rpx;text-overflow:ellipsis;white-space:nowrap}.category-count{display:flex;min-width:36rpx;height:36rpx;align-items:center;justify-content:center;margin-left:8rpx;border-radius:18rpx;background:#eee9e3;color:#8a7d70;font-size:20rpx}.category-nav.active .category-count{background:#e4f3e8;color:#377a4d}.dish-panel{display:flex;min-width:0;height:100%;flex:1;flex-direction:column}.dish-panel-head{display:flex;align-items:center;justify-content:space-between;padding:20rpx;border-bottom:2rpx solid #f0e8df}.dish-panel-title{min-width:0}.category-title{display:block;overflow:hidden;font-size:28rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.selected-count{display:block;margin-top:6rpx;color:#55a66f;font-size:21rpx}.select-all-btn{width:auto;height:58rpx;margin:0;padding:0 18rpx;border:2rpx solid #55a66f;border-radius:29rpx