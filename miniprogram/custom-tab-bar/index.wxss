.tab-shell {
  position: fixed;
  z-index: 1000;
  right: 22rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  left: 22rpx;
  display: flex;
  height: 112rpx;
  padding: 10rpx;
  border: 2rpx solid rgba(121, 89, 62, 0.08);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 16rpx 44rpx rgba(77, 52, 31, 0.16);
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  color: #948578;
}

.tab-item.active { background: #fff0e9; color: #ef6a4c; }
.tab-icon { height: 42rpx; font-size: 32rpx; line-height: 42rpx; }
.tab-text { margin-top: 3rpx; font-size: 22rpx; font-weight: 600; }
